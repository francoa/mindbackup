# voice-mind-backup — copy to .env and fill in.
# This project is self-contained: it reads only the real environment and this file.

# --- Telegram (required to run the bot) -------------------------------------
# Create a bot with @BotFather, paste the token here.
MINDBACKUP_TELEGRAM_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to send memos (you + partner).
# Find yours by messaging @userinfobot. The bot REFUSES to start if this is empty.
MINDBACKUP_ALLOWED_USERS=

# --- Vault ------------------------------------------------------------------
# Where the app writes memos. Required when running OUTSIDE Docker.
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian-vault
# Subfolder of the vault that memos land in.
MINDBACKUP_MEMO_DIR=Memos

# --- Speech to text ---------------------------------------------------------
# local
MINDBACKUP_STT_PROVIDER=local
# local: tiny|base|small|medium|large-v3
# `medium` benchmarked best on real Spanish audio: 0.92 key-term recall vs
# 0.85 for both small and large-v3 (tests/BENCHMARK.md). ~8s for a 30s memo,
# ~2.6 GB peak RAM — keep docker-compose's memory limit above that.
# `small` is the low-memory choice (0.85 recall, ~0.9 GB).
MINDBACKUP_STT_MODEL=medium
# Force a language (ISO 639-1, e.g. "es"). Leave empty to auto-detect —
# recommended if you code-switch between Spanish and English.
MINDBACKUP_STT_LANGUAGE=

# Vocabulary hint fed to Whisper as a prompt. Whisper biases toward words it
# has seen here — the cheapest fix for jargon ("bandeja" came back as
# "band Asia" without it). Keep it a BARE COMMA LIST: labelled formats like
# "Padel terms: ..." leak into the transcript. Add terms as you spot misses.
# (A trailing period is added automatically — without one Whisper mirrors the
# unpunctuated style and strips sentence breaks from the whole transcript.)
MINDBACKUP_VOCABULARY=padel, bandeja, vibora, chiquita, remate, revés, dejada, globo, lumbar, glute bridge, hamstring, dorsiflexion, scapula, Age of Empires

# --- Raw audio archive (C4: keep the source so transcripts are re-derivable) --
# Absolute path. Set empty to disable archiving. Required outside Docker.
MINDBACKUP_AUDIO_ARCHIVE=/path/to/your/voice-memo-archive

# --- Misc -------------------------------------------------------------------
# IANA timezone used to date memos. Empty = system local time.
MINDBACKUP_TIMEZONE=Europe/Madrid

# --- Docker compose ---------------------------------------------------------
# Host paths that docker-compose bind-mounts to /vault and /archive INSIDE the
# container. Only used by compose; the app itself never reads these.
# (Inside the container the app sees OBSIDIAN_VAULT_PATH=/vault, set in
# docker-compose.yml, so these two layers stay independent.)
VAULT_PATH=/path/to/your/obsidian-vault
ARCHIVE_PATH=/path/to/your/archive
# --- Intelligence layer (extract / ask) -------------------------------------
# Summariser + classifier. OPTIONAL: leave MINDBACKUP_LLM_MODEL empty and the
# bot behaves exactly as it did in M1 (transcribe + save, no extraction).
#
# Any OpenAI-compatible /chat/completions endpoint works. Configured below for
# Anthropic's OpenAI-compatibility layer; for OpenAI use
# https://api.openai.com/v1, for OpenRouter https://openrouter.ai/api/v1, for
# a local Ollama http://localhost:11434/v1 (any non-empty key).
#
# LOCAL / PRIVATE OPTION: transcripts never leave the machine. If you go this
# way, build a custom Ollama model rather than using a stock tag: the default
# 4K context silently truncates long memos, and models with thinking mode on
# by default return unparseable JSON. Set num_ctx 16384 and disable thinking.
MINDBACKUP_LLM_BASE_URL=https://api.anthropic.com/v1

# Haiku is the right default here: extraction is classification + tagging, the
# task Haiku is built for, at 1/2 the input cost of Sonnet 5. It also has no
# adaptive thinking, which matters because the OpenAI-compat layer IGNORES
# reasoning_effort — on claude-sonnet-5 thinking is on at `high` by default,
# spending latency and max_tokens budget you cannot turn down from here.
# Upgrade to claude-sonnet-5 only if referent resolution ("this project" ->
# the real name) proves unreliable on real memos.
MINDBACKUP_LLM_MODEL=claude-haiku-4-5

# Claude API key (console.anthropic.com). Sent as a Bearer token, which the
# compatibility layer accepts. In Docker this is read from
# /run/secrets/llm_api_key instead.
MINDBACKUP_LLM_API_KEY=

# Seconds before giving up on the model (default 60).
MINDBACKUP_LLM_TIMEOUT=60

# Subfolder of the vault for consolidated topic pages.
MINDBACKUP_TOPIC_DIR=Topics
